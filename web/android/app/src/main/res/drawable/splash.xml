<?xml version="1.0" encoding="utf-8"?>
<!-- Density-independent branded splash: solid dark field with the centred coin
     mark. Referenced by AppTheme.NoActionBarLaunch (values/styles.xml) and kept
     in sync with the SplashScreen backgroundColor in capacitor.config.ts. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center"
        android:drawable="@drawable/splash_logo" />
</layer-list>
